{
  "version": 2,
  "regions": [
    "gru1"
  ],
  "builds": [
    {
      "src": "./main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "0 17 * * *"
    }
  ]
}
